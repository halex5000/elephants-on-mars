{
  "name": "elephants-on-mars",
  "version": "0.1.0",
  "description": "A multiplayer team-building game: four roles, hidden information, get the animals to Mars.",
  "scripts": {
    "build": "node scripts/build-client.mjs && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "node scripts/build-client.mjs && tsx watch src/server/index.ts",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.client.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:load": "node --import tsx tests/load/load.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:load && npm run test:e2e",
    "infra:test": "npm --prefix infra test",
    "infra:synth": "npm --prefix infra run synth",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci --error-on-warnings . && npm run secrets",
    "secrets": "secretlint \"**/*\"",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && simple-git-hooks || true"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "lint-staged": "^17.6.1",
    "morphdom": "^2.7.8",
    "secretlint": "^14.0.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3"
  },
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run typecheck && npm run test:unit"
  },
  "lint-staged": {
    "*": "secretlint",
    "*.{ts,mjs,js,json,css,html}": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
